# These two browser-safe values are available in Supabase Project Settings > API.
# Never use a service_role, sb_secret_*, database password, or account token here.
# Optional paired overrides. Empty values use config/public-site.json for this website.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Explicit local read-only demo; keep false for the real website.
VITE_ATLAS_DEMO=false
